{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KetchUp",
  "version": "0.1.0",
  "identifier": "io.github.ryo09020.ketchup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KetchUp",
        "width": 1050,
        "height": 720,
        "minWidth": 260,
        "minHeight": 80,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  }
}
