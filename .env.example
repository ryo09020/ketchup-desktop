# Server configuration (optional - defaults to local development mode)
PORT=8080

# Supabase (optional - defaults to mock/local in-memory store)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini API Key (optional - defaults to built-in local heuristics & fallback)
# GEMINI_API_KEY=your-gemini-api-key
